# RetailIQ environment configuration
# Copy this file to ".env" and fill in your values. Never commit .env to git.
# Required for: python redshift/load/load_redshift.py  (warehouse load step)
# The PySpark ETL step needs NO credentials when using CSV fallback mode.

# --- Amazon Redshift connection ---
REDSHIFT_HOST=your-cluster.xxxxx.region.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev                   # Serverless default DB; the 'retailiq' schema is created inside it
REDSHIFT_USER=awsuser
REDSHIFT_PASSWORD=your-password-here

# --- MySQL connection (product/store/supplier/promotion masters) ---
# Leave blank to use CSV fallback mode (reads from data/raw/*.csv)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=retail_db
MYSQL_USER=
MYSQL_PASSWORD=

# --- Oracle CRM connection (customer data) ---
# Leave blank to use CSV fallback mode (reads from data/raw/*.csv)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=
ORACLE_PASSWORD=

# --- AWS S3 staging (for Redshift COPY, recommended for production) ---
# Leave blank to use direct INSERT fallback mode
S3_BUCKET=
S3_PREFIX=retailiq/curated
REDSHIFT_IAM_ROLE=
AWS_REGION=ap-south-1

# --- Pipeline paths (defaults work out of the box; override only if needed) ---
RAW_DATA_DIR=data/raw
CURATED_DATA_DIR=data/curated
REJECTED_DATA_DIR=data/rejected
DQ_LOG_DIR=data/curated/_dq_log
